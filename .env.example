# Copy to .env in the repo root. Do not commit secrets.

HOST=0.0.0.0
PORT=8080
LISTEN_MS=5000

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_COMPOSE_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PREDICT=80
OLLAMA_NUM_PREDICT_TOOLS=240

# Local Cursor CLI first (model Auto). On error, fall back to Ollama.
CURSOR_CLI_ENABLED=true
CURSOR_CLI_MODEL=auto
CURSOR_CLI_MODE=ask
CURSOR_CLI_TIMEOUT_S=60
# CURSOR_API_KEY=
# CURSOR_CLI_BIN=
WEATHER_CITY=Ha Noi
# Optional official Google Custom Search (otherwise Startpage/Brave):
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# STT: PhoWhisper, SYSTRAN faster-whisper, or ElevenLabs Scribe.
# Restart backend after changing this.
STT_ENGINE=phowhisper
# STT_ENGINE=faster-whisper
# STT_ENGINE=elevenlabs
PHOWHISPER_MODEL=vinai/PhoWhisper-small
# Official Whisper size when STT_ENGINE=faster-whisper:
# tiny | base | small | medium | large-v2 | large-v3 | turbo
WHISPER_MODEL=small
STT_LANGUAGE=vi
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_CPU_THREADS=0
# Required when STT_ENGINE=elevenlabs (Scribe). Do not commit the key.
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2

TTS_ENGINE=gtts
GTTS_LANG=vi
GTTS_TLD=com.vn

WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
