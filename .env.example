# Copy to .env in the repo root. Do not commit secrets.

HOST=0.0.0.0
PORT=8080

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PREDICT=80

STT_ENGINE=phowhisper
PHOWHISPER_MODEL=vinai/PhoWhisper-small
STT_DEVICE=auto
WHISPER_MODEL=small

TTS_ENGINE=gtts
GTTS_LANG=vi
GTTS_TLD=com.vn
